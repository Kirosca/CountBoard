; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "CountBoard"
#define MyAppVersion "1.3.0.3"
#define MyAppPublisher "Gaoyongxian"
#define MyAppURL "https://github.com/Gaoyongxian666/CountBoard"
#define MyAppExeName "CountBoard.exe"

[Setup]
AppId={{6DA65E00-FAAE-4286-B277-6D6F99519AD0}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={userdocs}/{#MyAppName}/{#MyAppVersion}
DisableProgramGroupPage=yes
OutputDir=.\dist_setup
OutputBaseFilename=CountBoard_{#MyAppVersion}
SetupIconFile=.\favicon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\{#MyAppExeName}

[Code]  
function InitializeSetup(): boolean;  
var  
  ResultStr: String;  
  ResultCode: Integer;  
begin  
  if RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{6DA65E00-FAAE-4286-B277-6D6F99519AD0}_is1', 'UninstallString', ResultStr) then  
    begin  
      ResultStr := RemoveQuotes(ResultStr);  
      Exec(ResultStr, '/silent', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);  
    end;  
    result := true;  
end;

[Languages]
Name: "chinesesimplified"; MessagesFile: "ChineseSimplified.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: ".\dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\favicon.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\introduction.md"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\del.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\home.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\edit.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\exit.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\github.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\help.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\recovery.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\update.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
